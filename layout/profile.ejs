<% const profile = profile_view_model(); %>
<section class="profile-page"<% if (profile.style) { %> style="<%- profile.style %>"<% } %>>
  <div class="profile-card" itemscope itemtype="http://schema.org/Person">
    <% if (profile.avatarUrl) { %>
      <div class="profile-avatar">
        <img src="<%- profile.avatarUrl %>" alt="<%- profile.avatarAlt %>" loading="lazy" itemprop="image" />
      </div>
    <% } %>
    <% if (profile.name) { %>
      <h1 class="profile-name" itemprop="name"><%= profile.name %></h1>
    <% } %>
    <% if (profile.title) { %>
      <p class="profile-title" itemprop="jobTitle"><%= profile.title %></p>
    <% } %>
    <% if (profile.location) { %>
      <p class="profile-location" itemprop="homeLocation"><i class="fa-solid fa-location-dot"></i> <span><%= profile.location %></span></p>
    <% } %>
    <% if (profile.intro) { %>
      <div class="profile-intro"><%- markdown(profile.intro) %></div>
    <% } %>
    <% if (profile.links.length) { %>
      <div class="profile-links" aria-label="<%- __('index.find_me_on') %>">
        <% profile.links.forEach(function(link) { %>
          <a class="profile-link" href="<%- link.href %>" target="<%- link.target %>"<% if (link.rel) { %> rel="<%- link.rel %>"<% } %> aria-label="<%- link.label %>"<% if (link.isIdentity) { %> itemprop="sameAs"<% } %>>
            <i class="<%= link.iconClasses %>"></i>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
  <% if (page.content) { %>
    <div class="profile-content e-content" itemprop="description">
      <%- page.content %>
    </div>
  <% } %>
</section>
