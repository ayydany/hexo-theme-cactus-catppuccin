if $accent_name == "red"
  $accent = $red
if $accent_name == "maroon"
  $accent = $maroon
if $accent_name == "peach"
  $accent = $peach
if $accent_name == "yellow"
  $accent = $yellow
if $accent_name == "green"
  $accent = $green
if $accent_name == "teal"
  $accent = $teal
if $accent_name == "sky"
  $accent = $sky
