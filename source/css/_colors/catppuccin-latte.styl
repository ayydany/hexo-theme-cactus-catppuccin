  $accent = $sapphire
if $accent_name == "blue"
  $accent = $blue
if $accent_name == "lavender"
  $accent = $lavender

$color-background = $base
$color-footer-mobile-1 = lighten($color-background, 2%)
$color-footer-mobile-2 = lighten($color-background, 12%)
$color-background-code = $surface0
$color-border = $surface2
